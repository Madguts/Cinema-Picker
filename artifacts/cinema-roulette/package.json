{
  "name": "@workspace/cinema-roulette",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @workspace/scripts run generate-showtimes && vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm --filter @workspace/scripts run generate-showtimes && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.7",
    "@tailwindcss/vite": "catalog:",
